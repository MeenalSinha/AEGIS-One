# AEGIS One — Environment Variables
# Copy this to .env and fill in your values

# ─── App ───────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── OpenAI / Azure OpenAI ─────────────────────────────────────
OPENAI_API_KEY=sk-...
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01
USE_AZURE_OPENAI=false

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secret@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Azure Services (optional) ─────────────────────────────────
AZURE_KEY_VAULT_URL=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_KEY=
AZURE_AI_SEARCH_INDEX=aegis-vectors

# ─── Azure Entra ID (optional) ─────────────────────────────────
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# ─── Telemetry ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ─── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Auth ──────────────────────────────────────────────────────
AEGIS_DEMO_API_KEY=aegis-demo-key-change-in-production

# ─── Rate Limits ───────────────────────────────────────────────
RATE_LIMIT_FIREWALL=100
RATE_LIMIT_REDTEAM=5
RATE_LIMIT_DEMO=20
